# Copy this file to .env and fill in values locally.
# Never put real API keys or passwords in this file or in git.

# FastAPI
APP_ENV=development

# PostgreSQL + PostGIS (used later; no password here)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/urbantherm

# Google Earth Engine (used later)
GEE_PROJECT_ID=your-gee-project-id
